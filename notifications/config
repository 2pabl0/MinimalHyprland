# ~/.config/mako/config
# Catppuccin Mocha · Mauve (mismos colores que la waybar)

font=JetBrainsMono Nerd Font 11
background-color=#11111bf2
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #313244

border-size=1
border-radius=14
padding=12
margin=10
width=350
icons=1
max-icon-size=48

anchor=top-right
layer=overlay
default-timeout=5000

[urgency=low]
border-color=#b4befe

[urgency=high]
border-color=#f38ba8
default-timeout=0

[mode=do-not-disturb]
invisible=1
